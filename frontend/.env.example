# AGDLAWAI frontend environment

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_API_BASE_URL=https://api.agdlawai.com

# Optional, used by local UI links and redirects where needed.
NEXT_PUBLIC_APP_URL=https://agdlawai.com

# Google OAuth is enabled in Supabase Auth Providers.
# Authorized JavaScript origin for local development:
# http://localhost:3000
# Authorized JavaScript origins for production:
# https://agdlawai.com
# https://www.agdlawai.com
# Authorized redirect URI:
# https://your-project-ref.supabase.co/auth/v1/callback
